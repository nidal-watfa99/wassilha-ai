# Wassilha AI backend - environment configuration
# Copy to .env and fill in real values. NEVER commit the real .env file.

# REQUIRED IN PRODUCTION: long random secret, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=168

# Database: SQLite (development default) or PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@host:5432/wassilha
DATABASE_URL=sqlite:///./data/wassilha.db

# Comma-separated allowed origins for the frontend (development Vite server shown)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true when serving over HTTPS
COOKIE_SECURE=false

# Upload limits (MB)
MAX_UPLOAD_MB=25
MAX_VOICE_MB=15

# AI provider (OpenAI-compatible chat completions API).
# Leave empty to run without AI - the app then shows an explicit
# "not configured" state instead of faking answers.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# WebRTC ICE servers. STUN only is usually enough on normal networks;
# restrictive NATs/firewalls require a TURN server (see docs/DEPLOYMENT.md).
STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Preview mode (hosted preview only): trust the proxy's X-Visitor-Id header as
# a session when cookies are unavailable (sandboxed preview iframe). Each preview
# visitor gets an isolated auto-provisioned account. NEVER enable in production.
PREVIEW_MODE=false
